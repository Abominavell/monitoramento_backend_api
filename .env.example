# Copie para ".env" na raiz do projeto e ajuste os valores.
# Nunca commite o arquivo .env (ele já está no .gitignore).

# Gere uma chave forte em produção, por exemplo:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-substitua-em-desenvolvimento

DEBUG=True

# Hosts permitidos, separados por vírgula (inclua .onrender.com se publicar no Render)
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# PostgreSQL: no PC use a External Database URL do painel do Render.
# No Web Service no Render use a Internal Database URL (ou deixe o Render injetar DATABASE_URL).
# Deixe em branco para usar SQLite (db.sqlite3) apenas em desenvolvimento local.
DATABASE_URL=

# true (padrão) para Postgres no Render; defina false só se a URL interna falhar com SSL.
DATABASE_SSL_REQUIRE=true

# Produção (DEBUG=false): origens do front que podem chamar a API (CORS), separadas por vírgula.
# Deve ser EXATAMENTE a origem do navegador: esquema + host, sem path e sem barra no final.
# Ex.: https://meu-front.onrender.com
# Se estiver vazio, o browser mostra "Failed to fetch" em POST com arquivo (multipart).
CORS_ALLOWED_ORIGINS=

# Origens confiáveis para CSRF (admin, formulários), com esquema. Ex.: https://meu-app.onrender.com
CSRF_TRUSTED_ORIGINS=

# --- Render (Web Service) ---
# Build (recomendado): chmod +x build.sh && ./build.sh
# Build (sem build.sh): pip install -r requirements.txt && python manage.py collectstatic --noinput && python manage.py migrate --noinput
# Start: gunicorn config.wsgi:application --bind 0.0.0.0:$PORT
# Detalhes: README.md
#
# Primeiro admin sem Shell (opcional; remova do painel após o primeiro deploy):
# BOOTSTRAP_SUPERUSER_USERNAME=
# BOOTSTRAP_SUPERUSER_PASSWORD=
# BOOTSTRAP_SUPERUSER_EMAIL=
